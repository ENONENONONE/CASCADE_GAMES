# THE FOLD at https://start.cascade.training — Caddy serves cascade_ar/ as the site root with its own TLS (Let's Encrypt),
# http redirected to https. The game is static files with no build step; the service worker, the gyro and the camera all need https.
#
# Install: see deploy/README.md. Paths assume the repository checked out at /srv/fold (deploy/deploy.sh keeps it on main).

start.cascade.training {
	root * /srv/fold/cascade_ar
	encode zstd gzip
	file_server

	# The page, the service worker and the data must never be served stale: the worker's own cache (sw.js CACHE) does the offline
	# copy, and its install reads past the HTTP cache, so http caching here buys nothing and a stale sw.js would pin an old game.
	@fresh {
		path / /index.html /sw.js /manifest.webmanifest *.js
		not path /vendor/*
	}
	header @fresh Cache-Control "no-cache"
	# three.js r128 never changes under this name.
	header /vendor/* Cache-Control "public, max-age=31536000, immutable"

	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json

	header {
		# The game asks for the camera, the gyro and the accelerometer on phones; keep them to this origin.
		Permissions-Policy "camera=(self), gyroscope=(self), accelerometer=(self), magnetometer=(self)"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		# Everything the game loads is its own: scripts, styles (inline), the vendor copy of three.js, blob: for the camera stream.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'self'"
		-Server
	}

	# Keep the generators' notes and demos out of the public site; the game's own README is fine to leave.
	@private path /parts/*/notes.md /parts/*/demo.html /parts/*/check.js /parts/*/test.js
	respond @private 404

	log {
		output file /var/log/caddy/start.cascade.training.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
